# Copie este arquivo para .env.local e preencha com os dados do seu
# projeto Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave privilegiada — nunca exponha no navegador. Usada apenas em rotas
# de servidor específicas (ex.: alternar cadastro público).
SUPABASE_SERVICE_ROLE_KEY=

# Habilita o botão "Carregar dados de demonstração" nas Configurações.
NEXT_PUBLIC_ENABLE_DEMO_SEED=true

# URL pública do site em produção — usada no link de redefinição de senha
# e para resolver imagens de compartilhamento (Open Graph). Em
# desenvolvimento pode ficar vazia (assume http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
